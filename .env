# ==============================================================================
# KAFKA BROKER CONFIGURATION
# ==============================================================================
# Address used by Gateways inside the Docker network to connect to Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# External port mapping for local host inspection
KAFKA_PORT=9092


# ==============================================================================
# NETWORK A CONFIGURATION
# ==============================================================================
# Unique network identifier (defines topic name and logging tags)
NETWORK_A_ID=network-a

# External host port mapping for Client A
CLIENT_A_PORT=8001

# Gateway A -> Client A internal Docker URL
CLIENT_A_INTERNAL_URL=http://client-a:8000

# Client A -> Gateway A internal Docker URL
GATEWAY_A_INTERNAL_URL=http://gateway-a:8000


# ==============================================================================
# NETWORK B CONFIGURATION
# ==============================================================================
# Unique network identifier (defines topic name and logging tags)
NETWORK_B_ID=network-b

# External host port mapping for Client B
CLIENT_B_PORT=8002

# Gateway B -> Client B internal Docker URL
CLIENT_B_INTERNAL_URL=http://client-b:8000

# Client B -> Gateway B internal Docker URL
GATEWAY_B_INTERNAL_URL=http://gateway-b:8000